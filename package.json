{
  "name": "attune-sense",
  "version": "0.4.0",
  "private": true,
  "description": "Attune — a portable body-sense MCP connector for AI. Interprets contactless vitals (Presage SmartSpectra) into behavioral nudges, not numbers. Prototype scaffold.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "demo": "node run-demo.js",
    "test:connector": "node test-connector.js",
    "test:adapter": "node test-adapter.js",
    "connector": "node src/server.js",
    "web": "node src/webServer.js",
    "test": "node --test \"tests/**/*.test.js\" && node test-adapter.js && node test-connector.js",
    "web:demo": "node src/webServer.js --demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@smartspectra/node-sdk": "3.5.0",
    "protobufjs": "7.6.6",
    "zod": "3.25.76"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
