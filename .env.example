# Copy to .env and fill in. .env is gitignored and never committed.

# Sensor: smartspectra (default, real SDK + webcam) | mock (demo: synthetic vitals, scripted replies)
ATTUNE_ADAPTER=smartspectra
# SmartSpectra key — https://physiology.presagetech.com
SMARTSPECTRA_API_KEY=

# Companion AI (Groq) — https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (default openai/gpt-oss-120b; also e.g. openai/gpt-oss-20b, qwen/qwen3.8-27b)
# ATTUNE_LLM_MODEL=openai/gpt-oss-120b

# In-app live voice (OpenAI Realtime, web-only service)
OPENAI_API_KEY=
